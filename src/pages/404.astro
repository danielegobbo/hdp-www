---
import Base from "../layouts/Base.astro";
---
<Base title="Página não encontrada">
  <div class="page">
    <span class="eyebrow">Erro 404</span>
    <h1>Página não<br /><em>encontrada.</em></h1>
    <p class="lead" style="max-width: 32rem;">A página que procura não existe ou foi movida. O site do hospital foi renovado e alguns endereços mudaram.</p>
    <div class="actions">
      <a class="button" href="/">Ir para o início</a>
      <a class="button ghost" href="/contactos/">Contactos</a>
    </div>
  </div>
</Base>
